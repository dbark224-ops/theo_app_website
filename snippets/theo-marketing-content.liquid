    .theo-included { display:grid; gap:12px; }
    .theo-included-row { align-items:flex-start; background:rgba(255,250,242,0.82); border:1px solid rgba(99,87,66,0.1); border-radius:22px; display:grid; gap:16px; grid-template-columns:48px 1fr 24px; padding:18px; }
