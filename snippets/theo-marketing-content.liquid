    .theo-hero-point span:first-child { background:var(--theo-blue); border-radius:999px; color:var(--theo-deep); flex:0 0 24px; font-size:0.8rem; height:24px; line-height:24px; text-align:center; }
    .theo-store-buttons { display:flex; flex-wrap:wrap; gap:14px; align-items:center; margin-top:28px; }
