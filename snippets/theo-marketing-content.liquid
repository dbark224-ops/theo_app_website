    .theo-nav { align-items:center; background:rgba(255,250,242,0.78); border:1px solid rgba(99,87,66,0.11); border-radius:999px; display:flex; gap:20px; justify-content:space-between; margin-bottom:42px; padding:12px 16px; position:sticky; top:14px; z-index:5; backdrop-filter:blur(16px); }
