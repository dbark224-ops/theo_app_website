    .theo-legal-intro h1,.theo-support-intro h1,.theo-legal-main h2,.theo-support-main h2 { margin:0 0 12px; line-height:1.05; letter-spacing:-0.045em; }
    .theo-legal-intro p,.theo-support-intro p,.theo-legal-main p,.theo-support-main p,.theo-legal-main li,.theo-support-main li { color:var(--theo-muted); line-height:1.72; }
    .theo-legal-main section,.theo-support-main section { padding-top:22px; margin-top:22px; border-top:1px solid rgba(99,87,66,0.08); }
    .theo-legal-main section:first-child,.theo-support-main section:first-child { padding-top:0; margin-top:0; border-top:0; }
    .theo-legal-main ul,.theo-support-main ul { padding-left:20px; margin:12px 0 0; }
    .theo-meta { display:grid; gap:14px; margin-top:18px; }
    .theo-meta-item { background:rgba(238,246,251,0.72); border:1px solid rgba(139,173,192,0.22); border-radius:20px; padding:16px 18px; }
    .theo-meta-item strong { display:block; margin-bottom:6px; font-size:0.94rem; color:var(--theo-text); }
    .theo-meta-item span,.theo-meta-item a { color:var(--theo-muted); text-decoration:none; line-height:1.6; }
    .theo-meta-item a:hover { text-decoration:underline; color:var(--theo-text); }
    .theo-callout { margin-top:18px; padding:18px 20px; background:rgba(185,230,255,0.34); border:1px solid rgba(139,173,192,0.28); border-radius:22px; color:var(--theo-stone); line-height:1.68; }
    .theo-footer { margin-top:26px; padding-top:20px; border-top:1px solid rgba(99,87,66,0.08); display:flex; justify-content:space-between; gap:18px; flex-wrap:wrap; color:var(--theo-muted); font-size:0.92rem; }
    .theo-footer a { color:var(--theo-stone); text-decoration:none; margin-right:14px; }
    .theo-footer a:hover { text-decoration:underline; }
    @media screen and (max-width:989px) { .theo-hero,.theo-story,.theo-grid,.theo-proof,.theo-section-head,.theo-showcase,.theo-steps,.theo-testimonials,.theo-final-cta,.theo-legal-hero { grid-template-columns:1fr; } .theo-visual { min-height:auto; padding-bottom:24px; } .theo-phone { margin:0 auto; max-width:390px; } .theo-float-card { position:relative; left:auto; right:auto; top:auto; bottom:auto; width:auto; margin:14px auto 0; max-width:420px; } .theo-hero-copy { padding-top:0; } .theo-final-cta { align-items:start; } }
    @media screen and (max-width:749px) { .theo-shell { padding:16px 14px 60px; } .theo-nav { align-items:flex-start; border-radius:24px; flex-direction:column; position:relative; top:auto; } .theo-nav-links { align-items:flex-start; display:grid; gap:10px; grid-template-columns:repeat(2,minmax(0,1fr)); width:100%; } .theo-nav-cta { text-align:center; } .theo-store-buttons { align-items:stretch; flex-direction:column; } .theo-store-badge { height:auto; justify-content:flex-start; width:100%; } .theo-store-badge--apple img,.theo-store-badge--google img { height:54px; } .theo-title { max-width:none; } .theo-hero { min-height:auto; } .theo-proof,.theo-curriculum { grid-template-columns:1fr; } .theo-section { margin-top:74px; } .theo-band,.theo-final-cta { border-radius:28px; padding:24px; } .theo-phone,.theo-feature,.theo-story-panel,.theo-app-card,.theo-step,.theo-quote,.theo-legal-intro,.theo-support-intro,.theo-legal-main,.theo-support-main { border-radius:24px; } .theo-included-row { grid-template-columns:42px 1fr; } .theo-plus { display:none; } }
  </style>

  <div class="theo-shell">
    <nav class="theo-nav" aria-label="Theo">
      <a class="theo-brand" href="/" aria-label="Theo home">
        <img class="theo-brand-logo" src="{{ 'theo-logo.png' | asset_url }}" alt="Theo">
      </a>
      <div class="theo-nav-links">
        {% if page_variant == 'home' %}
          <a href="#overview">Overview</a>
          <a href="#features">Features</a>
          <a href="#how-it-works">How it works</a>
          <a href="#testimonials">Testimonials</a>
          <a href="#faq">FAQ</a>
          {% assign theo_primary_store_link = apple_store_link %}
          {% if theo_primary_store_link == blank %}
            {% assign theo_primary_store_link = google_play_link %}
          {% endif %}
          {% if theo_primary_store_link == blank %}
            {% assign theo_primary_store_link = '#' %}
          {% endif %}
          <a class="theo-nav-cta" href="{{ theo_primary_store_link }}">Download</a>
        {% else %}
          <a href="https://theo.coach/pages/contact">Support</a>
          <a href="https://theo.coach/pages/privacy-policy">Privacy</a>
          <a href="https://theo.coach/pages/terms-of-service">Terms</a>
        {% endif %}
      </div>
    </nav>

    {% case page_variant %}
      {% when 'home' %}
        <div class="theo-hero" id="overview">
          <div class="theo-hero-copy">
            <span class="theo-eyebrow">AI mindset coach for athletes</span>
            <h1 class="theo-title">Train the voice inside your head.</h1>
            <p class="theo-lead">Theo is a voice-first reflection coach for athletes and performance-focused people. Build daily practices, talk through pressure, and turn your check-ins into a private journal that remembers what matters.</p>
            <div class="theo-hero-points">
              <div class="theo-hero-point"><span>1</span><span>Create practices for morning focus, pre-game confidence, resets, reflection, or whatever rhythm you want Theo to hold.</span></div>
              <div class="theo-hero-point"><span>2</span><span>Speak naturally with Theo instead of forcing yourself to type when your head is already full.</span></div>
              <div class="theo-hero-point"><span>3</span><span>Let summaries and memory build continuity so every session becomes more useful over time.</span></div>
            </div>
            <div class="theo-store-buttons">
              <a class="theo-store-badge theo-store-badge--apple" href="{{ apple_store_link | default: '#' }}" aria-label="Download on the App Store"><img src="{{ 'app-store-badge.png' | asset_url }}" alt="Download on the App Store"></a>
              <a class="theo-store-badge theo-store-badge--google" href="{{ google_play_link | default: '#' }}" aria-label="Get it on Google Play"><img src="{{ 'google-play-badge.png' | asset_url }}" alt="Get it on Google Play"></a>
            </div>
            <div class="theo-proof">
              <div class="theo-proof-item"><strong>5 minute intro</strong><span>Feel the coach before starting the free week.</span></div>
              <div class="theo-proof-item"><strong>Voice-first</strong><span>Journal through conversation, not blank pages.</span></div>
              <div class="theo-proof-item"><strong>Practice-led</strong><span>Structure your mindset work around real routines.</span></div>
            </div>
          </div>
          <div class="theo-visual">
            <div class="theo-float-card theo-float-card--coach">
              <h3>Your coach</h3>
              <p>You sound like you are carrying the whole day at once. Let's pull this back to the next controllable moment.</p>
            </div>
            <div class="theo-phone"><img class="theo-phone-shot" src="{{ 'theo-app-screenshot.png' | asset_url }}" alt="Theo app screenshot" loading="lazy" width="1242" height="2688"></div>
            <div class="theo-float-card theo-float-card--practice">
              <span class="theo-practice-meta">Today's practice</span>
              <h3>Pre-performance reset</h3>
              <p>5 min voice check-in before training.</p>
              <div class="theo-progress-bar"><span></span></div>
            </div>
          </div>
        </div>

        <section class="theo-section theo-story" id="features">
          <div class="theo-story-copy">
            <span class="theo-section-kicker">Achieve your goals</span>
            <h2 class="theo-title theo-title--wide" style="font-size:clamp(2.2rem,5vw,4.45rem);">Build a mindset routine that actually meets you where you are.</h2>
          </div>
          <div class="theo-story-copy">
            <p>Most athletes know reflection matters. The hard part is making it easy enough to repeat when life is busy, training is heavy, or the pressure is loud.</p>
            <p>Theo turns mindset work into a short conversation. You set the practice, Theo guides the check-in, and the app keeps track of the themes that keep coming back.</p>
            <p>It is not therapy, diagnosis, or medical care. It is practical daily support for calm, clarity, confidence, emotional regulation, and follow-through.</p>
          </div>
        </section>

        <section class="theo-section">
          <div class="theo-grid">
            <div class="theo-feature"><span class="theo-feature-icon">01</span><h3>Create practices for the moments that matter</h3><p>Morning intention, pre-game preparation, midday reset, evening reflection, manifestation, journaling, confidence, or your own custom routine.</p></div>
            <div class="theo-feature"><span class="theo-feature-icon">02</span><h3>Talk through pressure in real time</h3><p>When your thoughts are moving fast, Theo helps you slow down, sort what is controllable, and move into the next moment with more intention.</p></div>
            <div class="theo-feature"><span class="theo-feature-icon">03</span><h3>Let your reflections compound</h3><p>Theo summarizes check-ins and notices patterns so your journal becomes a living record of what you are learning about yourself.</p></div>
          </div>
        </section>

