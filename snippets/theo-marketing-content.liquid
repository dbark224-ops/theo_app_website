    .theo-quote { background:rgba(255,250,242,0.88); border:1px solid rgba(99,87,66,0.1); border-radius:28px; padding:24px; }
    .theo-stars { color:var(--theo-copper); letter-spacing:0.12em; margin-bottom:18px; }
