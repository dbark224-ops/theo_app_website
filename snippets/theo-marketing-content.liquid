      --theo-slate: #5d7380;
      --theo-steel: #8badc0;
      --theo-blue: #b9e6ff;
      --theo-deep: #171714;
      --theo-green: #d9e6d2;
      --theo-border: rgba(99, 87, 66, 0.12);
      background:
