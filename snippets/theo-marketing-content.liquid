    .theo-curriculum { display:grid; gap:12px; grid-template-columns:repeat(2,minmax(0,1fr)); margin-top:26px; }
    .theo-curriculum span { background:rgba(255,250,242,0.08); border:1px solid rgba(255,250,242,0.12); border-radius:18px; color:#fffaf2; font-weight:700; padding:15px 16px; }
