    .theo-task { align-items:center; background:#fff; border:1px solid rgba(99,87,66,0.08); border-radius:22px; display:grid; gap:12px; grid-template-columns:44px 1fr auto; margin-top:12px; padding:14px; }
    .theo-task-icon { align-items:center; background:var(--theo-green); border-radius:15px; display:flex; font-weight:900; height:44px; justify-content:center; width:44px; }
